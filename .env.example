# Copy to .env. Only set credentials for the providers you use.
# HF_TOKEN=your-hugging-face-token

# auto selects MLX on Apple Silicon, Transformers elsewhere.
LOCAL_LLM_PROVIDER=auto
# Leave unset to select the correct platform model automatically.
# LOCAL_LLM_MODEL=mlx-community/gemma-2-2b-it-4bit
# LOCAL_LLM_MODEL=google/gemma-2-2b-it
LOCAL_LLM_MAX_TOKENS=2500
LOCAL_LLM_TEMPERATURE=0.2

# Cloud use always requires explicit opt-in as well as a key.
LOCAL_LLM_USE_FIREWORKS=false
# FIREWORKS_API_KEY=your-fireworks-key
REMOTE_LLM_USE_FOR_DEEP=false
# GROQ_API_KEY=your-groq-key
# REMOTE_LLM_PROVIDER=groq
# REMOTE_LLM_MODEL=openai/gpt-oss-120b
# REMOTE_LLM_BASE_URL=https://api.groq.com/openai/v1
ACADEMICFORGE_CLOUD_TIMEOUT_SECONDS=45

# Local by default. Network exposure through start.sh requires an API key.
ACADEMICFORGE_BIND_HOST=127.0.0.1
ACADEMICFORGE_BACKEND_URL=http://127.0.0.1:8000
# ACADEMICFORGE_API_KEY=choose-a-long-random-key
ACADEMICFORGE_STARTUP_TIMEOUT_SECONDS=600
ACADEMICFORGE_MAX_REQUEST_BYTES=1048576
ACADEMICFORGE_REQUESTS_PER_MINUTE=60
ACADEMICFORGE_SEARCH_CONCURRENCY=2
ACADEMICFORGE_GENERATION_CONCURRENCY=1
# ACADEMICFORGE_RETRIEVAL_DEVICE=cpu
ACADEMICFORGE_SEARCH_MODE=fast
ACADEMICFORGE_SEARCH_CACHE_TTL_SECONDS=300

# Optional OpenJev on Apple Silicon: python -m scripts.start_openjev_mlx
JEV_ENABLED=false
# ACADEMICFORGE_SEARCH_MODE=quality
# JEV_ENABLED=true
# JEV_ENDPOINT=http://127.0.0.1:3000/v1/systemone
# JEV_MODEL=openjev
JEV_TIMEOUT_SECONDS=20
JEV_MAX_PAPERS=3
